# 변수 이름만 둔다. 실제 값은 .env(커밋 금지)에 쓴다.
# 배포(클라우드타입)에서는 같은 이름의 환경 변수로 넣는다. 둘 다 있으면 환경 변수가 우선한다.
# 기동 시 src/config/env.validation.ts가 검증한다 — 필수: MONGODB_URI, JWT_SECRET, USER_SERVICE_URL, INTERNAL_API_KEY

# 실행 환경: development | production | test. production이면 세션 쿠키 secure
NODE_ENV=

# HTTP 포트. 비우면 3001
PORT=

# MongoDB Atlas 접속 문자열
MONGODB_URI=

# base64 인코딩된 HS512 비밀키. Spring 사용자 서비스와 같은 값
JWT_SECRET=

# 허용할 CORS origin, 쉼표 구분. 비우면 http://localhost:3000
CORS_ORIGINS=

# Swagger UI(/api/posts/swagger) 접근 비밀번호. 비우면 Swagger 로그인 불가
SWAGGER_ADMIN_PASSWORD=

# Spring 사용자 서비스 (닉네임 조회)
USER_SERVICE_URL=

# 내부 서비스 간 공유 키. 사용자 서비스(X-API-KEY)와 Django 검색 서비스(X-Internal-Key)가 같은 값을 검증
INTERNAL_API_KEY=

# Django 검색 서비스 (게시글 인덱싱). 비우면 인덱싱을 건너뛴다
SEARCH_SERVICE_URL=
